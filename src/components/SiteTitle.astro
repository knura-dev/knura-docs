---
// Knura mark, "Knura" in the text color and "Docs" muted, as in the approved mockup.
import { logos } from 'virtual:starlight/user-images';
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	{logos.dark && <img alt="" src={logos.dark.src} width={logos.dark.width} height={logos.dark.height} />}
	<span translate="no">Knura <span class="docs">Docs</span></span>
</a>

<style>
	.site-title {
		align-items: center;
		gap: 0.6rem;
		font-size: 1.125rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
	}
	.docs {
		font-weight: 500;
		color: var(--sl-color-gray-3);
	}
	img {
		height: 1.75rem;
		width: auto;
	}
</style>
